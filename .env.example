# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# The deploy key does NOT live here. Keep it outside the repository entirely —
# see docs/DEPLOY.md. A key in a project directory is one `git add -A` away from
# being public, and a repository that has ever contained one is compromised
# whether or not the commit was pushed.

# --- Chain reads -------------------------------------------------------------
# Public endpoints are rate limited and documented for testing, not production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Oracle configuration ----------------------------------------------------
# Symbol -> Chainlink aggregator. Until this is set every asset reports NO_FEED
# and the desk labels its marks indicative, which is intentional.
# ROBINHOOD_FEEDS={"NVDA":{"feed":"0x...","maxStaleness":93600,"decimals":8}}

# Chainlink L2 sequencer uptime feed. Empty disables the check.
# ROBINHOOD_SEQUENCER_FEED=
ROBINHOOD_SEQUENCER_GRACE=1800

# Seconds before a scheduled multiplier change at which CORP_ACTION is reported.
ROBINHOOD_CORP_ACTION_WINDOW=7200

# --- Deployed contracts ------------------------------------------------------
# Set after deploying. With this empty the desk uses preflight settlement and
# says so; with it set, guarded settlement.
# VITE_EXACT_TRANSFER=0x...

# --- Optional ----------------------------------------------------------------
# AI brief. The desk works without it.
# XAI_API_KEY=
# DATABASE_URL=
